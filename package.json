{
  "name": "ai-chat-api",
  "version": "1.0.0",
  "description": "AI Chat API with Hono + Cloudflare Workers + D1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute ai-chat-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute ai-chat-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "hono": "^4.13.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.125.0"
  }
}
